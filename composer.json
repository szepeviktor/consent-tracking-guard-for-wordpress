{
    "name": "szepeviktor/consent-tracking-guard-for-wordpress",
    "description": "Consent-aware tracking, service disclosures, embeds, and WP Consent API sync",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "autoload": {
        "psr-4": {
            "SzepeViktor\\ConsentTrackingGuard\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Viktor Szépe",
            "email": "viktor@szepe.net"
        }
    ],
    "require": {
        "php": "~7.4.0 || ^8.0",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "szepeviktor/phpstan-wordpress": "^2.0",
        "szepeviktor/consistent-versions": "^1.2",
        "szepeviktor/phpcs-psr-12-neutron-hybrid-ruleset": "^1.1",
        "wp-coding-standards/wpcs": "3.1.0 as 2.3.0"
    },
    "scripts": {
        "make-pot": "wp i18n make-pot . languages/consent-tracking-guard-for-wordpress.pot --headers='{\"Report-Msgid-Bugs-To\":\"https://github.com/szepeviktor/consent-tracking-guard-for-wordpress/issues\"}'",
        "phpcs": "phpcs",
        "phpstan": "phpstan analyze",
        "test:consent-api": [
            "php tests/php/assets-script-guard.php",
            "php tests/php/consent-api-bridge.php",
            "php tests/php/facebook-for-woocommerce-bridge.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
