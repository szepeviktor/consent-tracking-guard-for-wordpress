#: src/Frontend/Assets.php:691 src/Frontend/Assets.php:1018
msgid "7 days"
msgstr "7 дней"

#: src/Frontend/Assets.php:692
msgid "Supports LinkedIn conversion attribution."
msgstr "Поддерживает атрибуцию конверсий LinkedIn."

#: src/Frontend/Assets.php:695
