msgstr "Различает посетителей для ежедневной аналитической отчетности."

#: src/Frontend/Assets.php:571
msgid "Loads analytics tags managed through Google Tag Manager."
msgstr "Загружает аналитические теги, управляемые через Google Tag Manager."

#: src/Frontend/Assets.php:583
msgid "Microsoft Clarity"
msgstr "Microsoft Clarity"

#: src/Frontend/Assets.php:589 src/Frontend/Assets.php:650
#: src/Frontend/Assets.php:655 src/Frontend/Assets.php:660
#: src/Frontend/Assets.php:733 src/Frontend/Assets.php:956
#: src/Frontend/Assets.php:1341 src/Frontend/Assets.php:1346
msgid "1 year"
