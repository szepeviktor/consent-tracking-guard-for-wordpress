#: src/AdminPage.php:389
msgid "Viktor's Consent and Tracking Guard"
msgstr "Viktor's Consent and Tracking Guard"

#. Plugin URI of the plugin
#: viktors-consent-tracking-guard.php
msgid "https://github.com/szepeviktor/consent-tracking-guard-for-wordpress"
msgstr "https://github.com/szepeviktor/consent-tracking-guard-for-wordpress"

#. Description of the plugin
#: viktors-consent-tracking-guard.php
msgid ""
"Controls consent-aware tracking, service disclosures, embeds, and WP Consent "
"API sync."
msgstr ""
"Баннер согласия на использование файлов cookie на базе Klaro с "
"совместимостью с WP Consent API."

#. Author of the plugin
#: viktors-consent-tracking-guard.php
msgid "Viktor Szépe"
msgstr "Viktor Szépe"

#. Author URI of the plugin
#: viktors-consent-tracking-guard.php
msgid "https://github.com/szepeviktor"
msgstr "https://github.com/szepeviktor"

#: src/AdminPage.php:56
msgid "Consent & Tracking"
msgstr "Consent & Tracking"

#: src/AdminPage.php:89
msgid "Banner copy"
msgstr "Текст баннера"

#: src/AdminPage.php:95
msgid "Display"
msgstr "Отображение"

#: src/AdminPage.php:101
msgid "Integrations"
msgstr "Интеграции"

