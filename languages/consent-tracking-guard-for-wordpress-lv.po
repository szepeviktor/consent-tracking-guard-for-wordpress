msgstr "Saglabā apmeklētāja YouTube privātuma stāvokli."

#: src/Frontend/Assets.php:1169
msgid "Maintains YouTube video-view session data."
msgstr "Uztur YouTube video skatīšanās sesijas datus."

#: src/Frontend/Assets.php:1174
msgid "8 months"
msgstr "8 mēneši"

#: src/Frontend/Assets.php:1175
msgid "Stores YouTube playback and display preferences."
msgstr "Saglabā YouTube atskaņošanas un attēlošanas preferences."

