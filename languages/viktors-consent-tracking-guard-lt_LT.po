msgstr "Neleidžia vėl rodyti atmesto Hotjar apklausos kvietimo."

#: src/Frontend/Assets.php:656
msgid "Prevents a completed Hotjar poll from reappearing."
msgstr "Neleidžia vėl rodyti užbaigtos Hotjar apklausos."

#: src/Frontend/Assets.php:661
msgid "Keeps a minimized Hotjar poll minimized."
msgstr "Išlaiko Hotjar apklausą sumažintą."

#: src/Frontend/Assets.php:666
msgid "Prevents repeated display of Hotjar feedback messaging."
msgstr "Neleidžia pakartotinai rodyti Hotjar atsiliepimų pranešimų."

#: src/Frontend/Assets.php:678
msgid "Meta Pixel"
msgstr "Meta Pixel"

#: src/Frontend/Assets.php:684 src/Frontend/Assets.php:692
#: src/Frontend/Assets.php:717 src/Frontend/Assets.php:725
#: src/Frontend/Assets.php:810
msgid "90 days"
msgstr "90 dienų"

#: src/Frontend/Assets.php:685 src/Frontend/Assets.php:718
#: src/Frontend/Assets.php:811
msgid "Identifies browsers for Meta advertising measurement."
msgstr "Identifikuoja naršykles Meta reklamos matavimui."

#: src/Frontend/Assets.php:693 src/Frontend/Assets.php:726
msgid "Stores the Meta advertising click identifier."
msgstr "Saugo Meta reklamos paspaudimo identifikatorių."

#: src/Frontend/Assets.php:699
msgid "Measures advertising performance and visitor actions for Meta."
msgstr "Matuoja Meta reklamos našumą ir lankytojų veiksmus."

#: src/Frontend/Assets.php:711
msgid "Meta for WooCommerce"
msgstr "Meta for WooCommerce"

#: src/Frontend/Assets.php:734
msgid ""
"Stores whether Meta for WooCommerce browser signals are held or released."
msgstr ""
"Saugo, ar Meta for WooCommerce naršyklės signalai sulaikyti, ar paleisti."

#: src/Frontend/Assets.php:740
msgid ""
"Measures WooCommerce product views, cart actions, and purchases for Meta "
"advertising."
msgstr ""
"Matuoja WooCommerce produktų peržiūras, krepšelio veiksmus ir pirkimus Meta "
"reklamai."

#: src/Frontend/Assets.php:755
msgid "PixelYourSite analytics"
msgstr "PixelYourSite analitika"

#: src/Frontend/Assets.php:771 src/Frontend/Assets.php:776
#: src/Frontend/Assets.php:781 src/Frontend/Assets.php:815
#: src/Frontend/Assets.php:820
msgid "Configured in PixelYourSite"
msgstr "Sukonfigūruota PixelYourSite"

#: src/Frontend/Assets.php:772
msgid "Stores whether this is the visitor’s first tracked visit."
msgstr "Saugo, ar tai pirmasis stebimas lankytojo apsilankymas."

#: src/Frontend/Assets.php:777
msgid "Stores the landing page for analytics attribution."
msgstr "Saugo nukreipimo puslapį analizės priskyrimui."

#: src/Frontend/Assets.php:782
msgid "Stores the traffic source for analytics attribution."
msgstr "Saugo srauto šaltinį analizės priskyrimui."

#: src/Frontend/Assets.php:785
msgid "Allows PixelYourSite analytics tags and attribution cookies."
msgstr "Leidžia PixelYourSite analizės žymas ir priskyrimo slapukus."

#: src/Frontend/Assets.php:797
msgid "PixelYourSite advertising"
msgstr "PixelYourSite reklama"

#: src/Frontend/Assets.php:816
msgid "Stores a PixelYourSite external identifier for advertising events."
msgstr "Saugo PixelYourSite išorinį identifikatorių reklamos įvykiams."

#: src/Frontend/Assets.php:821
msgid "Stores form-derived data used to improve advertising event matching."
msgstr ""
"Saugo iš formų gautus duomenis, naudojamus reklamos įvykių atitikimui gerinti."

#: src/Frontend/Assets.php:824
msgid ""
"Allows PixelYourSite advertising pixels, server events, and matching cookies."
msgstr ""
"Leidžia PixelYourSite reklamos pikselius, serverio įvykius ir atitikimo "
"slapukus."

#: src/Frontend/Assets.php:836 src/Frontend/Assets.php:863
msgid "Site Kit Sign in with Google"
msgstr "Site Kit Sign in with Google"

#: src/Frontend/Assets.php:847
msgid "Up to 180 days"
msgstr "Iki 180 dienų"

#: src/Frontend/Assets.php:848
msgid "Stores Google Identity Services prompt and sign-in state."
msgstr "Saugo Google Identity Services raginimo ir prisijungimo būseną."

#: src/Frontend/Assets.php:852
msgid "15 minutes"
msgstr "15 minučių"

#: src/Frontend/Assets.php:853
msgid "Secures the Site Kit Sign in with Google authentication request."
msgstr "Apsaugo Site Kit Sign in with Google autentifikavimo užklausą."

#: src/Frontend/Assets.php:857
msgid "5 minutes"
msgstr "5 minutės"

#: src/Frontend/Assets.php:858
msgid "Remembers where Site Kit should return the visitor after Google sign-in."
msgstr ""
"Įsimena, kur Site Kit turi grąžinti lankytoją po prisijungimo per Google."

#: src/Frontend/Assets.php:864
msgid "Supports Site Kit’s Google login button and One Tap sign-in."
msgstr "Palaiko Site Kit Google prisijungimo mygtuką ir One Tap prisijungimą."

#: src/Frontend/Assets.php:880
msgid "LinkedIn Insight Tag"
msgstr "LinkedIn Insight Tag"

#: src/Frontend/Assets.php:886
msgid "30 days"
msgstr "30 dienų"

#: src/Frontend/Assets.php:887
msgid "Stores the LinkedIn advertising click identifier."
msgstr "Saugo LinkedIn reklamos paspaudimo identifikatorių."

#: src/Frontend/Assets.php:891 src/Frontend/Assets.php:1250
msgid "7 days"
msgstr "7 dienos"

#: src/Frontend/Assets.php:892
msgid "Supports LinkedIn conversion attribution."
msgstr "Palaiko LinkedIn konversijų priskyrimą."

#: src/Frontend/Assets.php:895
msgid "Measures LinkedIn campaign performance and website conversions."
msgstr "Matuoja LinkedIn kampanijų našumą ir svetainės konversijas."

#: src/Frontend/Assets.php:907
msgid "Triple Whale Pixel"
msgstr "Triple Whale Pixel"

#: src/Frontend/Assets.php:913 src/Frontend/Assets.php:918
#: src/Frontend/Assets.php:923
msgid "Persistent"
msgstr "Nuolatinis"

#: src/Frontend/Assets.php:914
msgid "Stores Triple Whale pixel runtime and visit count data."
msgstr "Saugo Triple Whale pikselio veikimo ir apsilankymų skaičiaus duomenis."

#: src/Frontend/Assets.php:919
msgid "Stores recent page visit details for Triple Whale attribution."
msgstr ""
"Saugo naujausių puslapio apsilankymų informaciją Triple Whale priskyrimui."

#: src/Frontend/Assets.php:924
msgid "Stores the Triple Whale browser profile identifier."
msgstr "Saugo Triple Whale naršyklės profilio identifikatorių."

#: src/Frontend/Assets.php:927
msgid ""
"Measures visitor journeys, advertising attribution, and ecommerce events for "
"Triple Whale."
msgstr ""
"Matuoja lankytojų keliones, reklamos priskyrimą ir el. prekybos įvykius "
"Triple Whale."

