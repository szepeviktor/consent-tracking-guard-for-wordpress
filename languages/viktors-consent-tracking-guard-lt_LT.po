msgid "Do you want to load external content supplied by {title}?"
msgstr "Ar norite įkelti išorinį turinį, kurį teikia {title}?"

#: src/Frontend/Assets.php:352
msgid ""
"To agree to this service permanently, you must accept {title} in the {link}."
msgstr ""
"Norėdami nuolat sutikti su šia paslauga, turite sutikti su {title} skiltyje "
"{link}."

