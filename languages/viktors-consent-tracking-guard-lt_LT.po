msgstr "https://github.com/szepeviktor/consent-tracking-guard-for-wordpress"

#. Description of the plugin
#: viktors-consent-tracking-guard.php
msgid ""
"Controls consent-aware tracking, service disclosures, embeds, and WP Consent "
"API sync."
msgstr ""
"Valdo sekimą pagal sutikimą, informaciją apie paslaugas, įterptą turinį ir WP "
"Consent API sinchronizavimą."

#. Author of the plugin
#: viktors-consent-tracking-guard.php
msgid "Viktor Szépe"
msgstr "Viktor Szépe"

